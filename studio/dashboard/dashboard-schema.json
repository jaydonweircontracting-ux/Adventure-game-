{"$id":"https://jaydonweircontracting-ux.github.io/Adventure-game-/studio/dashboard/dashboard-schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"Schema for the ASHFALL Adventure Game development dashboard data. GitHub is the permanent source of truth; the dashboard reads from these files instead of hard-coded information. Never fabricate commit hashes, verification results, build numbers, or performance measurements. Label unsupported imported records as requiring verification.","properties":{"activeBuild":{"properties":{"blockedBy":{"description":"Blocker description when status is blocked, else null.","type":["string","null"]},"build":{"type":"integer"},"commit":{"description":"Commit hash, or null when no commit exists yet. Never fabricated.","type":["string","null"]},"description":{"type":"string"},"status":{"enum":["planned","in_progress","implemented","tested","verified","blocked","failed"],"type":"string"}},"required":["build","status"],"type":"object"},"buildHistory":{"items":{"properties":{"build":{"type":"integer"},"commit":{"description":"Commit hash verified against GitHub, or null when no commit exists. Never fabricated.","type":["string","null"]},"description":{"type":"string"},"qualityGateLevel":{"description":"Highest quality gate passed (1-4), or null when not verified.","type":["integer","null"]},"runId":{"type":["string","null"]},"status":{"enum":["planned","in_progress","implemented","tested","verified","blocked","failed"],"type":"string"},"verifiedAt":{"format":"date-time","type":["string","null"]}},"required":["build","status"],"type":"object"},"type":"array"},"buildQueue":{"items":{"properties":{"build":{"description":"Build number, or a stage/task name for non-build items.","type":["integer","string"]},"commit":{"type":["string","null"]},"description":{"type":"string"},"status":{"enum":["planned","in_progress","implemented","tested","verified","blocked","failed"],"type":"string"}},"required":["build","status","des