-  if (distanceFromGreenvale >= 7) return 'ocean';
-  if (point.y <= 5) return 'northwatch';
-  if (point.x <= 3) return 'brackenfen';
-  if (point.x >= 6) return 'ironwood';
-  if (point.y >= 9) return 'sunwash';
-  return 'greenvale';
-}
