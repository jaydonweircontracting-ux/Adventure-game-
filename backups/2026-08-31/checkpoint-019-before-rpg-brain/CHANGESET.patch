-    : { left: 23, top: 24, width: 54, height: 52 };
-  const specs = [
-    { left: 8, top: 11, width: 19, height: 13, scale: 1 },
-    { left: 73, top: 12, width: 19, height: 13, scale: 1 },
-    { left: 8, top: 75, width: 19, height: 13, scale: 1 },
